# ============================================================================
# MOCK vs LIVE — how to switch
# ============================================================================
# Every area of the app is controlled by its own "mock" | "live" flag below
# (AUTH_DATA_SOURCE, PRODUCTS_DATA_SOURCE, etc.) rather than one global
# switch. Everything defaults to "mock", which needs no backend at all —
# good for a demo. To try an area against the real backend, change just that
# one flag to "live" and fill in BACKEND_ORIGIN/JWT below. Read
# docs/BACKEND_INTEGRATION_GUIDE.md §2 before flipping anything beyond
# AUTH_DATA_SOURCE — most areas need real fixes first, tracked there.
# ============================================================================

# .NET backend origin — every server-to-server call in lib/api/client.ts is an
# absolute URL against this. e.g. https://localhost:7103 in dev (see
# docs/BACKEND_INTEGRATION_GUIDE.md for how to run the backend locally — its
# plain-HTTP port always redirects to this HTTPS one). Only read when at
# least one *_DATA_SOURCE below is "live".
BACKEND_ORIGIN=

# Path to a PEM export of a local backend's self-signed HTTPS dev cert, if
# BACKEND_ORIGIN points at one — lib/api/client.ts trusts just that origin
# for its own fetch calls (a scoped undici Agent). Leave unset for a real
# deployed backend with a real certificate. Do NOT use NODE_EXTRA_CA_CERTS
# instead — it breaks every other HTTPS call this app makes (e.g.
# next/font/google). See .env.local's own copy of this comment.
BACKEND_CA_CERT_PATH=

# Must match the .NET backend's JwtOptions.SigningKey/Issuer/Audience exactly
# — this app verifies the __Host-access_token cookie locally (proxy.ts +
# lib/auth/session.ts), so the two services need to agree. Still required
# while every *_DATA_SOURCE below is "mock" — the mock store signs tokens
# with this same key so session verification code doesn't need a
# mock-specific branch. Any value works in mock mode since nothing else
# needs to agree with it; leave AUTH_JWT_ISSUER/AUTH_JWT_AUDIENCE blank
# there too. See docs/MOCK_AUTH.md.
AUTH_JWT_SIGNING_KEY=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=

# "mock" (default) | "live" — flips lib/api/auth.ts and
# lib/api/vendor-profile.ts from an in-memory mock (register/login/session/
# vendor onboarding, no .NET backend required) to the real Zitadel-backed
# backend. Both fail the production build outright while "mock" — see
# docs/MOCK_AUTH.md for seeded demo accounts.
AUTH_DATA_SOURCE=mock
VENDOR_PROFILE_DATA_SOURCE=mock

# "mock" (default) | "live" — flips lib/api/products.ts from fixture data to
# the real backend once the Product+Offer shape mismatch is resolved — see
# docs/BACKEND_INTEGRATION_GUIDE.md §2.5.
PRODUCTS_DATA_SOURCE=mock

# "mock" (default) | "live" — flips every lib/api/admin/*.ts adapter that has
# a live branch (Vendors, Staff, Roles, Products moderation, Audit log)
# between lib/api/mocks/admin-store.ts and the real backend. Fails the
# production build outright while "mock" — see lib/api/admin/data-source.ts.
ADMIN_DATA_SOURCE=mock

# "stub" (default) | "live" — lib/auth/permissions.ts fails open with a
# dev-only warning while "stub" (the backend has no "get my permissions"
# endpoint yet). A production build FAILS OUTRIGHT if this is still "stub"
# by design. See docs/BACKEND_INTEGRATION_GUIDE.md §2.6.
PERMISSIONS_SOURCE=stub

# Leave unset. Narrow escape hatch for a throwaway demo/preview deploy with no
# live backend — set to "true" to let a production build proceed with mock/
# stub sources instead of failing the build. Never set this for a real
# production release — see docs/MOCK_AUTH.md.
ALLOW_MOCK_IN_PRODUCTION=
