# .NET backend origin — every server-to-server call in lib/api/client.ts is an
# absolute URL against this. e.g. http://localhost:5000 in dev.
BACKEND_ORIGIN=

# Must match the .NET backend's JwtOptions.SigningKey exactly — this app verifies
# the __Host-access_token cookie locally (proxy.ts + lib/auth/session.ts), so the
# two services need the same signing secret. See design doc §3. Still required
# while AUTH_DATA_SOURCE=mock below — the mock store signs tokens with this same
# key so session verification code doesn't need a mock-specific branch. Any
# value works in mock mode since nothing else needs to agree with it; leave
# AUTH_JWT_ISSUER/AUTH_JWT_AUDIENCE blank there too. See docs/MOCK_AUTH.md.
AUTH_JWT_SIGNING_KEY=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=

# "mock" (default) | "live" — flips lib/api/products.ts from fixture data to the
# real backend once a Product API exists. See design doc §1/§4.
PRODUCTS_DATA_SOURCE=mock

# "mock" (default) | "live" — flips lib/api/auth.ts and lib/api/vendor-profile.ts
# from an in-memory mock (register/login/session/vendor onboarding, no .NET
# backend required) to the real Zitadel-backed backend. Both fail the production
# build outright while "mock" — see docs/MOCK_AUTH.md for seeded demo accounts
# and exactly how to flip these once the backend is reachable.
AUTH_DATA_SOURCE=mock
VENDOR_PROFILE_DATA_SOURCE=mock

# "stub" (default) | "live" — lib/auth/permissions.ts fails open with a dev-only
# warning while "stub" (the backend doesn't expose per-user permissions yet), and
# a production build FAILS OUTRIGHT if this is still "stub" by design. See design
# doc §5/§10.
PERMISSIONS_SOURCE=stub

# Leave unset. Narrow escape hatch for a throwaway demo/preview deploy with no
# live backend — set to "true" to let a production build proceed with
# AUTH_DATA_SOURCE/VENDOR_PROFILE_DATA_SOURCE=mock and PERMISSIONS_SOURCE=stub
# instead of failing the build. Never set this for a real production release —
# see docs/MOCK_AUTH.md.
ALLOW_MOCK_IN_PRODUCTION=
